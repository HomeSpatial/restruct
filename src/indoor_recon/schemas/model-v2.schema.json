{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://indoor-reconstruction.local/contracts/model/v2",
  "type":"object","additionalProperties":false,
  "required":["schema_version","kind","scene_id","coordinate_frame","revision","vertices","materials","objects","boundary_policy"],
  "properties":{
    "schema_version":{"const":2},"kind":{"const":"model"},"scene_id":{"$ref":"#/$defs/id"},
    "coordinate_frame":{"const":"work_z_up_metres"},"revision":{"type":"integer","minimum":1},
    "boundary_policy":{"enum":["open","closed"]},"notes":{"type":"string"},
    "vertices":{"type":"object","additionalProperties":{"$ref":"#/$defs/vec3"}},
    "materials":{"type":"object","additionalProperties":{"$ref":"#/$defs/material"}},
    "objects":{"type":"array","items":{"$ref":"#/$defs/object"}}
  },
  "$defs":{
    "id":{"type":"string","minLength":1},
    "vec2":{"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2},
    "vec3":{"type":"array","items":{"type":"number"},"minItems":3,"maxItems":3},
    "row4":{"type":"array","items":{"type":"number"},"minItems":4,"maxItems":4},
    "pose":{"type":"array","items":{"$ref":"#/$defs/row4"},"minItems":4,"maxItems":4},
    "ring":{"type":"array","minItems":3,"items":{"$ref":"#/$defs/vec2"}},
    "node_ring":{"type":"array","minItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "asset":{"type":"object","additionalProperties":false,"required":["root","path"],"properties":{"root":{"$ref":"#/$defs/id"},"path":{"$ref":"#/$defs/id"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"bytes":{"type":"integer","minimum":0},"role":{"type":"string"}}},
    "source":{"type":"object","additionalProperties":false,"required":["kind","reference"],"properties":{"kind":{"enum":["measurement","prediction","inference","user","legacy_record"]},"reference":{"$ref":"#/$defs/asset"},"record_id":{"type":"string"},"note":{"type":"string"},"frame_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "mesh_source":{"type":"object","additionalProperties":false,"required":["asset","asset_axes"],"properties":{"asset":{"$ref":"#/$defs/asset"},"asset_axes":{"enum":["z_up","gltf_y_up"]},"node":{"$ref":"#/$defs/id"}}},
    "material":{"type":"object","additionalProperties":false,"properties":{
      "name":{"type":"string"},"base_color_srgb":{"$ref":"#/$defs/vec3"},"roughness":{"type":"number","minimum":0,"maximum":1},"metallic":{"type":"number","minimum":0,"maximum":1},"alpha":{"type":"number","minimum":0,"maximum":1},
      "base_color_texture":{"$ref":"#/$defs/asset"},"roughness_texture":{"$ref":"#/$defs/asset"},"normal_texture":{"$ref":"#/$defs/asset"},"source_mesh":{"$ref":"#/$defs/mesh_source"},"uv_work":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/row4"}},"uv_box_m":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number","exclusiveMinimum":0}},"uv_box_space":{"enum":["work","object"]},"uv_rotate_deg":{"type":"number"}
    }},
    "object":{"type":"object","additionalProperties":false,"required":["id","category","revision","geometry","sources"],"properties":{
      "id":{"$ref":"#/$defs/id"},"category":{"$ref":"#/$defs/id"},"revision":{"type":"integer","minimum":1},"parent_id":{"$ref":"#/$defs/id"},"host_id":{"$ref":"#/$defs/id"},"T_parent_from_object":{"$ref":"#/$defs/pose"},"material_id":{"$ref":"#/$defs/id"},"label":{"type":"string"},"review_notes":{"type":"string"},"role":{"enum":["enclosure","component"]},"sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}},
      "geometry":{"oneOf":[
        {"type":"object","additionalProperties":false,"required":["type","size_m"],"properties":{"type":{"const":"box"},"size_m":{"$ref":"#/$defs/vec3"}}},
        {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"const":"assembly"}}},
        {"type":"object","additionalProperties":false,"required":["type","boundary_ids"],"properties":{"type":{"const":"surface"},"boundary_ids":{"$ref":"#/$defs/node_ring"},"holes_ids":{"type":"array","items":{"$ref":"#/$defs/node_ring"}},"thickness_m":{"type":"number","minimum":0},"offset_m":{"type":"number"}}},
        {"type":"object","additionalProperties":false,"required":["type","boundary_ids"],"properties":{"type":{"const":"opening"},"boundary_ids":{"$ref":"#/$defs/node_ring"},"fill":{"enum":["none","panel"]},"panel_thickness_m":{"type":"number","exclusiveMinimum":0},"angle_degrees":{"type":"number"}}},
        {"type":"object","additionalProperties":false,"required":["type","boundary_m","bottom_m","top_m"],"properties":{"type":{"const":"prism"},"boundary_m":{"$ref":"#/$defs/ring"},"holes_m":{"type":"array","items":{"$ref":"#/$defs/ring"}},"bottom_m":{"type":"number"},"top_m":{"type":"number"}}},
        {"type":"object","additionalProperties":false,"required":["type","asset","asset_axes"],"properties":{"type":{"const":"mesh_reference"},"asset":{"$ref":"#/$defs/asset"},"asset_axes":{"enum":["z_up","gltf_y_up"]},"node":{"$ref":"#/$defs/id"},"scale_xyz":{"$ref":"#/$defs/vec3"}}}
      ]}
    }}
  }
}
